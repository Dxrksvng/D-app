# Copy to backend/.env (never commit .env). All values are optional.
# Avalanche Data API key — https://build.avax.network/console/utilities/data-api-keys
DATA_API_KEY=
# Routescan key (raises limits) — optional
ROUTESCAN_API_KEY=
# WalletConnect / Reown project id — enables the "WalletConnect (QR)" option for mobile wallets
WALLETCONNECT_PROJECT_ID=
# Comma-separated origins allowed to call the API from a browser (use the frontend's URL in production)
ALLOWED_ORIGINS=*
# Signs the on-chain "Verified by BridgeSecure" memo. Same value on every instance; changing it invalidates old memos.
ATTESTATION_SECRET=
RATE_LIMIT_PER_MIN=30
PORT=8080
# Set to 1 only behind a trusted proxy / load balancer (Cloud Run, Render, Fly)
TRUST_PROXY=0
